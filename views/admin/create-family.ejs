<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Create Family</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    :root {
      --brown-primary: #704214;
      --brown-dark: #592d0f;
      --brown-light: #d2b48c;
      --brown-lighter: #f4e8d8;
      --brown-accent: #8b6f47;
      --ink: var(--brown-dark);
      --muted: var(--brown-accent);
      --panel: rgba(255, 255, 255, 0.95);
      --border: rgba(112, 66, 20, 0.15);
      --accent: var(--brown-primary);
      --surface: #f4e8d8;
    }

    * {
      font-family: "Manrope", sans-serif;
    }

    body {
      background:
        radial-gradient(circle at top left, rgba(112, 66, 20, 0.12), transparent 32%),
        radial-gradient(circle at top right, rgba(139, 111, 71, 0.15), transparent 28%),
        linear-gradient(135deg, #f4e8d8 0%, #e8dcc8 100%);
      min-height: 100vh;
      color: var(--ink);
    }

    .page-shell {
      max-width: 1320px;
    }

    .hero-bar {
      background: linear-gradient(135deg, rgba(112, 66, 20, 0.96), rgba(89, 45, 15, 0.95));
      color: #fff;
      border: 2px solid rgba(210, 180, 140, 0.3);
      box-shadow: 0 24px 60px rgba(89, 45, 15, 0.25);
    }

    .hero-bar h1 {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .hero-bar p {
      font-size: 1.1rem;
      letter-spacing: 0.3px;
    }

    .hero-kicker {
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.85);
      font-weight: 700;
    }

    .surface-card,
    .member-card,
    .summary-card,
    .success-card {
      background: var(--panel);
      backdrop-filter: blur(16px);
      border: 2px solid var(--brown-light);
      box-shadow: 0 18px 40px rgba(89, 45, 15, 0.12);
      border-radius: 16px;
      border-left: 6px solid var(--brown-primary);
    }

    .section-badge {
      width: 3rem;
      height: 3rem;
      border-radius: 0.95rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(112, 66, 20, 0.15), rgba(139, 111, 71, 0.12));
      color: var(--brown-primary);
      flex: 0 0 auto;
      font-weight: 700;
      font-size: 1.1rem;
    }

    .form-label {
      font-weight: 800;
      color: var(--brown-dark);
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      margin-bottom: 0.7rem;
    }

    .form-control,
    .form-select {
      border: 2px solid var(--brown-light);
      border-radius: 11px;
      box-shadow: 0 2px 8px rgba(112, 66, 20, 0.05);
      padding: 0.85rem 1.1rem;
      font-size: 1.05rem;
      color: var(--brown-dark);
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--brown-primary);
      box-shadow: 0 0 0 0.25rem rgba(112, 66, 20, 0.15);
      color: var(--brown-dark);
    }

    .form-control::placeholder {
      color: var(--brown-accent);
    }

    .soft-divider {
      border-top: 2px dashed rgba(112, 66, 20, 0.2);
    }

    .member-card {
      border-radius: 16px;
      transition: all 0.3s ease;
    }

    .member-card:hover {
      box-shadow: 0 24px 48px rgba(89, 45, 15, 0.15);
      transform: translateY(-2px);
    }

    .member-card .card-header {
      background: linear-gradient(135deg, rgba(112, 66, 20, 0.05), transparent);
      border-bottom: 2px solid var(--brown-light);
      padding: 1.35rem !important;
    }

    .member-card .card-header h6 {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--brown-dark);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      margin: 0;
    }

    .upload-box {
      border: 2px dashed var(--brown-light);
      border-radius: 13px;
      min-height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem 1rem;
      background: linear-gradient(135deg, rgba(244, 232, 216, 0.5), rgba(210, 180, 140, 0.2));
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .upload-box:hover {
      border-color: var(--brown-primary);
      background: rgba(112, 66, 20, 0.08);
    }

    .upload-box small {
      color: var(--brown-accent);
      text-align: center;
      font-size: 1rem;
      font-weight: 600;
    }

    .upload-box.photo-selected {
      background: linear-gradient(135deg, rgba(112, 66, 20, 0.08), transparent);
      border-color: var(--brown-primary);
    }

    .upload-box.photo-selected small {
      color: var(--brown-primary);
      font-weight: 700;
    }

    .member-actions .btn {
      min-width: 9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      font-size: 1rem;
      padding: 0.85rem 1.5rem;
    }

    .sticky-actions {
      position: sticky;
      bottom: 1rem;
      z-index: 5;
      gap: 1rem;
    }

    .note-pill {
      border-radius: 999px;
      background: linear-gradient(135deg, rgba(112, 66, 20, 0.15), rgba(139, 111, 71, 0.1));
      color: var(--brown-primary);
      font-weight: 800;
      font-size: 0.95rem;
      padding: 0.65rem 1.2rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .form-hint {
      color: var(--brown-accent);
      font-size: 0.95rem;
      font-weight: 600;
    }

    .btn {
      font-weight: 800;
      border-radius: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      transition: all 0.3s ease;
      font-size: 1.05rem;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--brown-primary), var(--brown-accent));
      border: none;
      box-shadow: 0 8px 20px rgba(112, 66, 20, 0.3);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, var(--brown-dark), var(--brown-primary));
      box-shadow: 0 12px 32px rgba(89, 45, 15, 0.4);
      transform: translateY(-3px);
    }

    .btn-light {
      background: linear-gradient(135deg, #ffffff, #faf6f1);
      color: var(--brown-dark);
      border: 2px solid var(--brown-light);
      box-shadow: 0 6px 16px rgba(112, 66, 20, 0.15);
    }

    .btn-light:hover {
      background: linear-gradient(135deg, #faf6f1, #f4e8d8);
      color: var(--brown-dark);
      box-shadow: 0 8px 24px rgba(112, 66, 20, 0.25);
    }

    .btn-lg {
      padding: 1rem 2rem;
    }

    .btn-outline-secondary {
      border: 2px solid var(--brown-light);
      color: var(--brown-primary);
    }

    .btn-outline-secondary:hover {
      background: var(--brown-light);
      color: white;
      border-color: var(--brown-primary);
    }

    .btn-outline-danger {
      border: 2px solid #c9302c;
      color: #c9302c;
    }

    .btn-outline-danger:hover {
      background: #c9302c;
      color: white;
    }

    h1, h2, h3, h4, h5, h6 {
      color: var(--brown-dark);
      font-weight: 800;
    }

    .display-6 {
      font-size: 2.2rem;
    }

    .d-none {
      display: none;
    }

    .alert {
      font-size: 1.05rem;
      border: none;
      border-radius: 12px;
      box-shadow: 0 6px 16px rgba(112, 66, 20, 0.12);
      padding: 1.2rem 1.5rem;
      font-weight: 600;
    }

    .rounded-4 {
      border-radius: 18px !important;
    }
  </style>
</head>
<body>
  <div class="container-fluid page-shell py-4 py-lg-5">
    <div class="hero-bar rounded-4 p-4 p-lg-5 mb-4">
      <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3">
        <div>
          <div class="hero-kicker mb-2">Admin workflow</div>
          <h1 class="display-6 fw-bold mb-2">Create Family Record</h1>
          <p class="mb-0 text-white-50">Complete the household family record for the logged-in user account.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/admin/dashboard" class="btn btn-light btn-lg">
            <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
          </a>
        </div>
      </div>
    </div>

    <div id="formAlert" class="alert alert-danger d-none" role="alert"></div>

    <form id="createFamilyForm" method="POST" action="/admin/view/create-family" enctype="multipart/form-data">
      <div class="row g-4">
        <div class="col-12">
          <div class="surface-card rounded-4 p-4">
            <div class="d-flex align-items-start gap-3 mb-4">
              <div class="section-badge"><i class="bi bi-shield-lock fs-5"></i></div>
              <div>
                <h2 class="h5 fw-bold mb-1">User Account</h2>
                <p class="mb-0 form-hint">Create user account credentials for this family.</p>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-lg-6">
                <label class="form-label">Email <span class="text-danger">*</span></label>
                <input type="email" class="form-control" name="email" placeholder="Enter email address" required>
                <div class="form-hint mt-1">Must be unique and will be used to sign in.</div>
              </div>
              <div class="col-lg-6">
                <label class="form-label">Password <span class="text-danger">*</span></label>
                <input type="password" class="form-control" name="password" placeholder="Enter password" minlength="6" required>
                <div class="form-hint mt-1">Minimum 6 characters for security.</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="surface-card rounded-4 p-4">
            <div class="d-flex align-items-start gap-3 mb-4">
              <div class="section-badge"><i class="bi bi-people-fill fs-5"></i></div>
              <div>
                <h2 class="h5 fw-bold mb-1">My Parents</h2>
                <p class="mb-0 form-hint">Optional fields for the head of family context.</p>
              </div>
            </div>

            <div class="row g-4">
              <div class="col-lg-6">
                <div class="member-card h-100 rounded-4">
                  <div class="card-header p-3 border-0">
                    <h3 class="h6 fw-bold mb-0"><i class="bi bi-person-hearts me-2 text-primary"></i>Father</h3>
                  </div>
                  <div class="card-body p-3 p-lg-4">
                    <div class="mb-3">
                      <label class="form-label">Father Name</label>
                      <input type="text" class="form-control" name="father_name" placeholder="Enter father name">
                    </div>
                    <div>
                      <label class="form-label">Father Image</label>
                      <input type="file" id="father_image_file" class="form-control d-none" name="father_image" accept="image/*" onchange="handlePhotoSelect(this, 'father_image')">
                      <div class="upload-box" onclick="showPhotoOptions('father_image')">
                        <small>Click to upload or capture photo</small>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-lg-6">
                <div class="member-card h-100 rounded-4">
                  <div class="card-header p-3 border-0">
                    <h3 class="h6 fw-bold mb-0"><i class="bi bi-person-heart me-2 text-danger"></i>Mother</h3>
                  </div>
                  <div class="card-body p-3 p-lg-4">
                    <div class="mb-3">
                      <label class="form-label">Mother Name</label>
                      <input type="text" class="form-control" name="mother_name" placeholder="Enter mother name">
                    </div>
                    <div>
                      <label class="form-label">Mother Image</label>
                      <input type="file" id="mother_image_file" class="form-control d-none" name="mother_image" accept="image/*" onchange="handlePhotoSelect(this, 'mother_image')">
                      <div class="upload-box" onclick="showPhotoOptions('mother_image')">
                        <small>Click to upload or capture photo</small>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="surface-card rounded-4 p-4">
            <div class="d-flex align-items-start gap-3 mb-4">
              <div class="section-badge"><i class="bi bi-heart fs-5"></i></div>
              <div>
                <h2 class="h5 fw-bold mb-1">My Spouse</h2>
                <p class="mb-0 form-hint">Add spouse details if applicable.</p>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-lg-6">
                <label class="form-label">Name</label>
                <input type="text" class="form-control" name="spouse_name" placeholder="Enter spouse name">
              </div>
              <div class="col-lg-3">
                <label class="form-label">Gender</label>
                <select class="form-select" name="spouse_gender">
                  <option value="">Select gender</option>
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="col-lg-3">
                <label class="form-label">Mobile</label>
                <input type="tel" class="form-control" name="spouse_mobile" placeholder="10 digit mobile" maxlength="10">
              </div>
              <div class="col-lg-6">
                <label class="form-label">Occupation</label>
                <input type="text" class="form-control" name="spouse_occupation" placeholder="Enter occupation">
              </div>
              <div class="col-lg-6">
                <label class="form-label">Image</label>
                <input type="file" id="spouse_image_file" class="form-control d-none" name="spouse_image" accept="image/*" onchange="handlePhotoSelect(this, 'spouse_image')">
                <div class="upload-box" onclick="showPhotoOptions('spouse_image')">
                  <small>Click to upload or capture photo</small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="surface-card rounded-4 p-4">
            <div class="d-flex align-items-start gap-3 mb-4">
              <div class="section-badge"><i class="bi bi-person-badge fs-5"></i></div>
              <div>
                <h2 class="h5 fw-bold mb-1">My Details</h2>
                <p class="mb-0 form-hint">The head of family record saved with the new user account.</p>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-lg-6">
                <label class="form-label">Full Name</label>
                <input type="text" class="form-control" name="my_name" placeholder="Enter full name" required>
              </div>
              <div class="col-lg-3">
                <label class="form-label">Gender</label>
                <select class="form-select" name="my_gender" required>
                  <option value="">Select gender</option>
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="col-lg-3">
                <label class="form-label">DOB</label>
                <input type="date" class="form-control" name="my_dob">
              </div>
              <div class="col-lg-4">
                <label class="form-label">Mobile</label>
                <input type="tel" class="form-control" name="my_mobile" placeholder="10 digit mobile" pattern="[0-9]{10}" maxlength="10" required>
              </div>
              <div class="col-lg-4">
                <label class="form-label">Occupation</label>
                <input type="text" class="form-control" name="my_occupation" placeholder="Enter occupation">
              </div>
              <div class="col-lg-4">
                <label class="form-label">Image</label>
                <input type="file" id="my_image_file" class="form-control d-none" name="my_image" accept="image/*" onchange="handlePhotoSelect(this, 'my_image')">
                <div class="upload-box" onclick="showPhotoOptions('my_image')">
                  <small>Click to upload or capture photo</small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="surface-card rounded-4 p-4">
            <div class="d-flex align-items-start gap-3 mb-4">
              <div class="section-badge"><i class="bi bi-house-door fs-5"></i></div>
              <div>
                <h2 class="h5 fw-bold mb-1">Address</h2>
                <p class="mb-0 form-hint">This address is used for the family head and related family rows.</p>
              </div>
            </div>

            <div class="row g-3">
              <div class="col-md-3">
                <label class="form-label">Door No</label>
                <input type="text" class="form-control" name="door_no" placeholder="Door no">
              </div>
              <div class="col-md-5">
                <label class="form-label">Street</label>
                <input type="text" class="form-control" name="street" placeholder="Street name">
              </div>
              <div class="col-md-4">
                <label class="form-label">Pincode</label>
                <input type="text" class="form-control" name="pincode" placeholder="Pincode" maxlength="6">
              </div>
              <div class="col-md-6">
                <label class="form-label">State</label>
                <select class="form-select" name="state" id="stateSelect">
                  <option value="">Select state</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">District</label>
                <select class="form-select" name="district" id="districtSelect">
                  <option value="">Select district</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div class="col-12">
          <div class="surface-card rounded-4 p-4">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
              <div class="d-flex align-items-start gap-3">
                <div class="section-badge"><i class="bi bi-person-plus fs-5"></i></div>
                <div>
                  <h2 class="h5 fw-bold mb-1">Children</h2>
                  <p class="mb-0 form-hint">Add one or more children. Leave the section empty if there are none.</p>
                </div>
              </div>
              <button type="button" class="btn btn-outline-primary" id="addChildBtn">
                <i class="bi bi-plus-circle me-2"></i>Add Child
              </button>
            </div>

            <div id="childrenContainer" class="d-grid gap-3"></div>
          </div>
        </div>

        <div class="col-12">
          <div class="surface-card rounded-4 p-4">
            <div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
              <div class="d-flex align-items-start gap-3">
                <div class="section-badge"><i class="bi bi-people fs-5"></i></div>
                <div>
                  <h2 class="h5 fw-bold mb-1">Siblings</h2>
                  <p class="mb-0 form-hint">Forward relationship is saved from the main person to each sibling.</p>
                </div>
              </div>
              <button type="button" class="btn btn-outline-secondary" id="addSiblingBtn">
                <i class="bi bi-plus-circle me-2"></i>Add Sibling
              </button>
            </div>

            <div id="siblingsContainer" class="d-grid gap-3"></div>
          </div>
        </div>

        <div class="col-12 sticky-actions">
          <div class="surface-card rounded-4 p-3 p-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
              <div class="note-pill mb-2"><i class="bi bi-info-circle"></i>Validation</div>
              <div class="form-hint">Name and a 10-digit mobile are required for the main person record.</div>
            </div>
            <div class="d-flex gap-2 member-actions">
              <a href="/admin/dashboard" class="btn btn-outline-secondary btn-lg">Cancel</a>
              <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-check2-circle me-2"></i>Save Family
              </button>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>

  <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content success-card rounded-4">
        <div class="modal-body text-center p-4 p-lg-5">
          <div class="mx-auto mb-3 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 4rem; height: 4rem; background: rgba(15, 118, 110, 0.12); color: var(--accent);">
            <i class="bi bi-check2 fs-1"></i>
          </div>
          <h3 class="h4 fw-bold mb-2">Family saved successfully</h3>
          <p class="text-muted mb-4">The user account, head of family, and related people have been saved.</p>
          <a id="successLink" href="/admin/dashboard" class="btn btn-success btn-lg">Return to Dashboard</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    const childrenContainer = document.getElementById('childrenContainer');
    const siblingsContainer = document.getElementById('siblingsContainer');
    const addChildBtn = document.getElementById('addChildBtn');
    const addSiblingBtn = document.getElementById('addSiblingBtn');
    const formAlert = document.getElementById('formAlert');
    const successModal = new bootstrap.Modal(document.getElementById('successModal'));
    const successLink = document.getElementById('successLink');

    let childIndex = 0;
    let siblingIndex = 0;
    let stateDistrictData = {};

    function showAlert(message) {
      formAlert.textContent = message;
      formAlert.classList.remove('d-none');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function clearAlert() {
      formAlert.textContent = '';
      formAlert.classList.add('d-none');
    }

    function buildFileFieldMarkup(label, name) {
      return `
        <div>
          <label class="form-label">${label}</label>
          <input type="file" class="form-control" name="${name}" accept="image/*">
        </div>
      `;
    }

    function addChildCard() {
      const currentIndex = childIndex++;
      const card = document.createElement('div');
      card.className = 'member-card rounded-4';
      card.innerHTML = `
        <div class="card-header p-3 p-lg-4 d-flex justify-content-between align-items-center gap-3">
          <div>
            <div class="fw-bold">Child ${currentIndex + 1}</div>
            <div class="form-hint">Add basic details and an optional photo.</div>
          </div>
          <button type="button" class="btn btn-outline-danger btn-sm remove-member-btn">
            <i class="bi bi-trash me-1"></i>Remove
          </button>
        </div>
        <div class="card-body p-3 p-lg-4">
          <div class="row g-3">
            <div class="col-lg-5">
              <label class="form-label">Name</label>
              <input type="text" class="form-control" name="children[${currentIndex}][name]" placeholder="Child name">
            </div>
            <div class="col-lg-3">
              <label class="form-label">Gender</label>
              <select class="form-select" name="children[${currentIndex}][gender]">
                <option value="">Select gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="col-lg-4">
              <label class="form-label">DOB</label>
              <input type="date" class="form-control" name="children[${currentIndex}][dob]">
            </div>
            <div class="col-12">
              <label class="form-label">Image</label>
              <input type="file" id="child_${currentIndex}_image_file" class="form-control d-none" name="children[${currentIndex}][image]" accept="image/*" onchange="handlePhotoSelect(this, 'child_${currentIndex}_image')">
              <div class="upload-box" onclick="showPhotoOptions('child_${currentIndex}_image')">
                <small>Click to upload or capture photo</small>
              </div>
            </div>
          </div>
        </div>
      `;

      childrenContainer.appendChild(card);
    }

    function addSiblingCard() {
      const currentIndex = siblingIndex++;
      const card = document.createElement('div');
      card.className = 'member-card rounded-4';
      card.innerHTML = `
        <div class="card-header p-3 p-lg-4 d-flex justify-content-between align-items-center gap-3">
          <div>
            <div class="fw-bold">Sibling ${currentIndex + 1}</div>
            <div class="form-hint">Store the relationship as a forward link from the main person.</div>
          </div>
          <button type="button" class="btn btn-outline-danger btn-sm remove-member-btn">
            <i class="bi bi-trash me-1"></i>Remove
          </button>
        </div>
        <div class="card-body p-3 p-lg-4">
          <div class="row g-3">
            <div class="col-lg-4">
              <label class="form-label">Name</label>
              <input type="text" class="form-control" name="siblings[${currentIndex}][name]" placeholder="Sibling name">
            </div>
            <div class="col-lg-3">
              <label class="form-label">Gender</label>
              <select class="form-select" name="siblings[${currentIndex}][gender]">
                <option value="">Select gender</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="col-lg-3">
              <label class="form-label">Relation</label>
              <select class="form-select" name="siblings[${currentIndex}][relation]">
                <option value="brother">Brother</option>
                <option value="sister">Sister</option>
              </select>
            </div>
            <div class="col-lg-2">
              <label class="form-label">DOB</label>
              <input type="date" class="form-control" name="siblings[${currentIndex}][dob]">
            </div>
            <div class="col-12">
              <label class="form-label">Image</label>
              <input type="file" id="sibling_${currentIndex}_image_file" class="form-control d-none" name="siblings[${currentIndex}][image]" accept="image/*" onchange="handlePhotoSelect(this, 'sibling_${currentIndex}_image')">
              <div class="upload-box" onclick="showPhotoOptions('sibling_${currentIndex}_image')">
                <small>Click to upload or capture photo</small>
              </div>
            </div>
          </div>
        </div>
      `;

      siblingsContainer.appendChild(card);
    }

    function loadDistrictOptions(stateValue) {
      const districtSelect = document.getElementById('districtSelect');
      districtSelect.innerHTML = '<option value="">Select district</option>';

      if (!stateValue || !stateDistrictData[stateValue]) {
        return;
      }

      stateDistrictData[stateValue].forEach((district) => {
        const option = document.createElement('option');
        option.value = district;
        option.textContent = district;
        districtSelect.appendChild(option);
      });
    }

    async function loadStateDistrictData() {
      try {
        const response = await fetch('/data/india-states-districts.json');
        stateDistrictData = await response.json();

        const stateSelect = document.getElementById('stateSelect');
        Object.keys(stateDistrictData).forEach((state) => {
          const option = document.createElement('option');
          option.value = state;
          option.textContent = state;
          stateSelect.appendChild(option);
        });
      } catch (error) {
        console.error('Failed to load state and district data:', error);
      }
    }

    document.addEventListener('click', (event) => {
      if (event.target.closest('.remove-member-btn')) {
        event.target.closest('.member-card').remove();
      }
    });

    addChildBtn.addEventListener('click', addChildCard);
    addSiblingBtn.addEventListener('click', addSiblingCard);

    document.getElementById('stateSelect').addEventListener('change', (event) => {
      loadDistrictOptions(event.target.value);
    });

    document.getElementById('createFamilyForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      clearAlert();

      const form = event.currentTarget;
      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Unable to save family data.');
        }

        successLink.href = result.redirectUrl || '/admin/dashboard';
        successModal.show();
      } catch (error) {
        showAlert(error.message || 'An unexpected error occurred.');
      }
    });

    loadStateDistrictData();

    // Photo options handling
    let currentPhotoTarget = null;
    let cameraStream = null;

    function showPhotoOptions(target) {
      currentPhotoTarget = target;
      Swal.fire({
        title: 'Choose Photo Option',
        showCancelButton: true,
        showDenyButton: true,
        confirmButtonText: 'Upload Photo',
        denyButtonText: 'Take Photo',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#0f766e',
        denyButtonColor: '#0f766e'
      }).then((result) => {
        if (result.isConfirmed) {
          // Upload Photo
          const fileInput = document.getElementById(`${target}_file`);
          if (fileInput) fileInput.click();
        } else if (result.isDenied) {
          // Take Photo
          openCamera(target);
        }
      });
    }

    function openCamera(target) {
      Swal.fire({
        title: 'Capture Photo',
        html: '<video id="cameraVideo" autoplay style="width: 100%; max-width: 400px;"></video>',
        showCancelButton: true,
        confirmButtonText: 'Capture',
        cancelButtonText: 'Cancel',
        confirmButtonColor: '#0f766e',
        didOpen: () => {
          navigator.mediaDevices.getUserMedia({ video: true })
            .then(stream => {
              cameraStream = stream;
              const video = document.getElementById('cameraVideo');
              video.srcObject = stream;
            })
            .catch(err => {
              console.error('Error accessing camera:', err);
              Swal.fire('Error', 'Unable to access camera', 'error');
            });
        },
        preConfirm: () => {
          return new Promise((resolve) => {
            const video = document.getElementById('cameraVideo');
            const canvas = document.createElement('canvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0);
            canvas.toBlob(resolve, 'image/jpeg', 0.9);
          });
        }
      }).then((result) => {
        if (result.isConfirmed && result.value) {
          if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
          }
          processPhotoFile(result.value, target);
        } else {
          if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
          }
        }
      });
    }

    function processPhotoFile(file, target) {
      const maxSizeKB = 250;
      const maxSizeBytes = maxSizeKB * 1024;

      if (file.size <= maxSizeBytes) {
        updatePhotoPlaceholder(target, file.size);
        assignFileToInput(file, target);
      } else {
        compressImage(file, maxSizeBytes, target);
      }
    }

    function compressImage(file, maxSizeBytes, target) {
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d');
      const img = new Image();

      img.onload = function() {
        let quality = 0.8;
        let compressedFile;

        const compress = () => {
          canvas.width = img.width;
          canvas.height = img.height;
          ctx.drawImage(img, 0, 0);

          canvas.toBlob((blob) => {
            if (blob.size <= maxSizeBytes) {
              compressedFile = blob;
              updatePhotoPlaceholder(target, blob.size);
              assignFileToInput(blob, target);
            } else if (quality > 0.1) {
              quality -= 0.1;
              compress();
            } else {
              updatePhotoPlaceholder(target, blob.size);
              assignFileToInput(blob, target);
            }
          }, 'image/jpeg', quality);
        };

        compress();
      };

      img.src = URL.createObjectURL(file);
    }

    function updatePhotoPlaceholder(target, sizeBytes) {
      const uploadBox = document.querySelector(`[onclick="showPhotoOptions('${target}')"]`);
      if (uploadBox) {
        const sizeKB = (sizeBytes / 1024).toFixed(2);
        uploadBox.classList.add('photo-selected');
        uploadBox.innerHTML = `<small>Photo selected - ${sizeKB} KB</small>`;
      }
    }

    function assignFileToInput(file, target) {
      const input = document.getElementById(`${target}_file`);
      if (input) {
        const dt = new DataTransfer();
        dt.items.add(new File([file], `photo_${Date.now()}.jpg`, { type: 'image/jpeg' }));
        input.files = dt.files;
      }
    }

    function handlePhotoSelect(input, target) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        processPhotoFile(file, target);
      }
    }
  </script>
</body>
</html>