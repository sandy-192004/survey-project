<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Family</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <style>
    :root {
      --brown-primary: #704214;
      --brown-dark: #592d0f;
      --brown-light: #d2b48c;
      --brown-lighter: #f4e8d8;
      --brown-accent: #8b6f47;
    }

    * {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background: linear-gradient(135deg, #f4e8d8 0%, #e8dcc8 100%);
      min-height: 100vh;
      color: var(--brown-dark);
    }

    .container {
      max-width: 100%;
      margin: 0 auto;
      padding: 0 1rem;
    }

    h3, h4, h5, h6 {
      color: var(--brown-dark);
      font-weight: 700;
    }

    h3 {
      font-size: 1.75rem;
      letter-spacing: 0.5px;
    }

    .section-title {
      font-weight: 800;
      margin-bottom: 1.2rem;
      color: var(--brown-dark);
      font-size: 1.35rem;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      background: linear-gradient(90deg, var(--brown-primary), var(--brown-accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      padding-bottom: 0.5rem;
      border-bottom: 3px solid var(--brown-light);
    }

    .card {
      border: 0;
      background: linear-gradient(135deg, #ffffff, #faf6f1);
      box-shadow: 0 12px 32px rgba(89, 45, 15, 0.15), 0 4px 12px rgba(112, 66, 20, 0.1);
      border-radius: 18px;
      border-left: 5px solid var(--brown-primary);
      transition: all 0.3s ease;
      overflow: hidden;
      width: 100%;
    }

    .card:hover {
      box-shadow: 0 16px 48px rgba(89, 45, 15, 0.2), 0 6px 16px rgba(112, 66, 20, 0.15);
      transform: translateY(-2px);
    }

    .card.p-3 {
      padding: 2rem !important;
    }

    .preview {
      width: 110px;
      height: 110px;
      object-fit: cover;
      border-radius: 14px;
      border: 4px solid var(--brown-light);
      background: linear-gradient(135deg, #faf6f1, #f4e8d8);
      box-shadow: 0 6px 16px rgba(89, 45, 15, 0.12);
    }

    .dynamic-item {
      border: 2px solid var(--brown-light);
      border-radius: 14px;
      padding: 2rem;
      margin-bottom: 2rem;
      background: linear-gradient(135deg, #ffffff, #faf6f1);
      box-shadow: 0 4px 12px rgba(112, 66, 20, 0.08);
      transition: all 0.3s ease;
      width: 100%;
    }

    .dynamic-item:hover {
      border-color: var(--brown-accent);
      box-shadow: 0 6px 18px rgba(112, 66, 20, 0.12);
    }

    .dynamic-item-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--brown-lighter);
      gap: 1rem;
    }

    .dynamic-item-title {
      font-weight: 700;
      font-size: 1.1rem;
      color: var(--brown-dark);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin: 0;
      flex: 1;
    }

    .dynamic-item-remove-btn {
      background: linear-gradient(135deg, #dc3545, #c82333) !important;
      border: none !important;
      color: white !important;
      font-weight: 600;
      padding: 0.5rem 1rem !important;
      font-size: 0.85rem;
      white-space: nowrap;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(220, 53, 69, 0.25);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .dynamic-item-remove-btn:hover {
      background: linear-gradient(135deg, #c82333, #a71d2a) !important;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(220, 53, 69, 0.35);
      color: white !important;
    }

    .dynamic-item-fields {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .dynamic-item-field {
      display: flex;
      flex-direction: column;
    }

    .dynamic-item-field .form-label {
      margin-bottom: 0.6rem;
    }

    .dynamic-item-image-block {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
      padding: 1.5rem;
      background: linear-gradient(135deg, #faf6f1, #f4e8d8);
      border-radius: 12px;
      border: 2px dashed var(--brown-light);
      width: fit-content;
    }

    .dynamic-item-preview {
      width: 100px;
      height: 100px;
      object-fit: cover;
      border-radius: 10px;
      border: 3px solid var(--brown-light);
      background: white;
      box-shadow: 0 4px 12px rgba(112, 66, 20, 0.1);
    }

    .dynamic-item-actions {
      display: flex;
      gap: 0.75rem;
      width: 100%;
      flex-wrap: wrap;
    }

    .dynamic-item-actions .btn {
      flex: 1;
      min-width: 140px;
      padding: 0.6rem 1rem;
      font-size: 0.85rem;
    }

    @media (max-width: 768px) {
      .dynamic-item {
        padding: 1.5rem;
      }

      .dynamic-item-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .dynamic-item-title {
        width: 100%;
      }

      .dynamic-item-remove-btn {
        width: 100%;
        justify-content: center;
      }

      .dynamic-item-fields {
        grid-template-columns: 1fr;
      }

      .dynamic-item-actions .btn {
        min-width: auto;
        flex: 1;
      }

      .dynamic-item-image-block {
        width: 100%;
        align-items: center;
      }

      .dynamic-item-preview {
        width: 80px;
        height: 80px;
      }
    }

    @media (max-width: 480px) {
      .dynamic-item {
        padding: 1rem;
        margin-bottom: 1.5rem;
      }

      .dynamic-item-header {
        padding-bottom: 0.75rem;
        margin-bottom: 1rem;
      }

      .dynamic-item-title {
        font-size: 1rem;
      }

      .dynamic-item-remove-btn {
        padding: 0.4rem 0.8rem !important;
        font-size: 0.75rem;
      }

      .form-label {
        font-size: 0.85rem;
      }

      .form-control,
      .form-select {
        padding: 0.6rem 0.8rem;
        font-size: 0.95rem;
      }

      .dynamic-item-actions {
        flex-direction: column;
      }

      .dynamic-item-actions .btn {
        width: 100%;
      }
    }
      font-weight: 700;
      color: var(--brown-primary);
      font-size: 0.95rem;
      margin-bottom: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .form-control,
    .form-select {
      border: 2px solid var(--brown-light);
      border-radius: 10px;
      padding: 0.75rem 1rem;
      font-size: 1rem;
      background-color: #ffffff;
      color: var(--brown-dark);
      box-shadow: 0 2px 8px rgba(112, 66, 20, 0.05);
      transition: all 0.3s ease;
    }

    .form-control:focus,
    .form-select:focus {
      border-color: var(--brown-primary);
      box-shadow: 0 0 0 0.2rem rgba(112, 66, 20, 0.15);
      color: var(--brown-dark);
      background-color: #ffffff;
    }

    .form-control::placeholder {
      color: var(--brown-accent);
    }

    .btn {
      font-weight: 700;
      border-radius: 10px;
      padding: 0.75rem 1.5rem;
      font-size: 1rem;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      transition: all 0.3s ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--brown-primary), var(--brown-accent));
      border: none;
      box-shadow: 0 6px 16px rgba(112, 66, 20, 0.25);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, var(--brown-dark), var(--brown-primary));
      box-shadow: 0 8px 24px rgba(89, 45, 15, 0.35);
      transform: translateY(-2px);
    }

    .btn-outline-secondary {
      border: 2px solid var(--brown-light);
      color: var(--brown-primary);
      background-color: transparent;
    }

    .btn-outline-secondary:hover {
      background-color: var(--brown-light);
      color: var(--brown-dark);
      border-color: var(--brown-primary);
    }

    .btn-outline-danger {
      border: 2px solid #c9302c;
      color: #c9302c;
    }

    .btn-outline-danger:hover {
      background-color: #c9302c;
      color: white;
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
    }

    .choose-photo-btn {
      background: linear-gradient(135deg, var(--brown-accent), var(--brown-primary));
      color: white !important;
      border: none !important;
      box-shadow: 0 4px 12px rgba(112, 66, 20, 0.2);
    }

    .choose-photo-btn:hover {
      background: linear-gradient(135deg, var(--brown-primary), var(--brown-dark));
      box-shadow: 0 6px 16px rgba(89, 45, 15, 0.3);
    }

    .align-items-center {
      gap: 1rem !important;
    }

    .mt-2 {
      margin-top: 1rem !important;
    }

    .alert {
      border-radius: 12px;
      border: none;
      padding: 1rem 1.5rem;
      font-size: 1.05rem;
      font-weight: 600;
      box-shadow: 0 4px 12px rgba(112, 66, 20, 0.1);
    }

    .d-flex h3 {
      font-size: 1.6rem;
    }
  </style>
</head>
<body>
  <div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0">Edit Family</h3>
      <a href="/admin/dashboard" class="btn btn-outline-secondary">Back</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
      <script>window.setTimeout(function(){ alert("Family updated successfully"); }, 100);</script>
    <% } %>

    <form method="POST" action="/admin/edit/<%= userId %>" enctype="multipart/form-data" id="adminEditForm">
      <div class="card p-3 mb-3">
        <h5 class="section-title">MY PARENTS</h5>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Father Name</label>
            <input class="form-control" name="father_name" value="<%= family.father.name %>">
            <label class="form-label mt-2">Father Mobile</label>
            <input class="form-control mobile-field" name="father_mobile" maxlength="10" value="<%= family.father.mobile %>">
            <label class="form-label mt-2">Father Occupation</label>
            <input class="form-control" name="father_occupation" value="<%= family.father.occupation %>">
            <label class="form-label mt-2">Father Image</label>
            <div class="d-flex align-items-center gap-2">
              <img src="<%= family.father.image ? '/uploads/' + family.father.image : 'https://via.placeholder.com/88?text=Father' %>" class="preview" id="fatherPreview">
              <input type="file" class="d-none photo-input" id="father_image_input" accept="image/*" name="father_image" data-preview-id="fatherPreview" onchange="previewImage(this, 'fatherPreview')">
              <button type="button" class="btn btn-outline-secondary choose-photo-btn" data-input-id="father_image_input">Upload Photo</button>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label">Mother Name</label>
            <input class="form-control" name="mother_name" value="<%= family.mother.name %>">
            <label class="form-label mt-2">Mother Mobile</label>
            <input class="form-control mobile-field" name="mother_mobile" maxlength="10" value="<%= family.mother.mobile %>">
            <label class="form-label mt-2">Mother Occupation</label>
            <input class="form-control" name="mother_occupation" value="<%= family.mother.occupation %>">
            <label class="form-label mt-2">Mother Image</label>
            <div class="d-flex align-items-center gap-2">
              <img src="<%= family.mother.image ? '/uploads/' + family.mother.image : 'https://via.placeholder.com/88?text=Mother' %>" class="preview" id="motherPreview">
              <input type="file" class="d-none photo-input" id="mother_image_input" accept="image/*" name="mother_image" data-preview-id="motherPreview" onchange="previewImage(this, 'motherPreview')">
              <button type="button" class="btn btn-outline-secondary choose-photo-btn" data-input-id="mother_image_input">Upload Photo</button>
            </div>
          </div>
        </div>
      </div>

      <div class="card p-3 mb-3">
        <h5 class="section-title">MY DETAILS</h5>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Name *</label>
            <input class="form-control" name="my_name" required value="<%= family.self.name %>">
          </div>
          <div class="col-md-3">
            <label class="form-label">Gender</label>
            <select class="form-select" name="my_gender">
              <option value="">Select</option>
              <option value="Male" <%= family.self.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= family.self.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= family.self.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">DOB</label>
            <input type="date" class="form-control" name="my_dob" value="<%= family.self.dob %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Mobile *</label>
            <input class="form-control mobile-field" name="my_mobile" maxlength="10" required value="<%= family.self.mobile %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Occupation</label>
            <input class="form-control" name="my_occupation" value="<%= family.self.occupation %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Image</label>
            <div class="d-flex align-items-center gap-2">
              <img src="<%= family.self.image ? '/uploads/' + family.self.image : 'https://via.placeholder.com/88?text=Me' %>" class="preview" id="selfPreview">
              <input type="file" class="d-none photo-input" id="my_image_input" accept="image/*" name="my_image" data-preview-id="selfPreview" onchange="previewImage(this, 'selfPreview')">
              <button type="button" class="btn btn-outline-secondary choose-photo-btn" data-input-id="my_image_input">Upload Photo</button>
            </div>
          </div>
        </div>
      </div>

      <div class="card p-3 mb-3">
        <h5 class="section-title">MY SPOUSE</h5>
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Name</label>
            <input class="form-control" name="spouse_name" value="<%= family.spouse.name %>">
          </div>
          <div class="col-md-2">
            <label class="form-label">Gender</label>
            <select class="form-select" name="spouse_gender">
              <option value="">Select</option>
              <option value="Male" <%= family.spouse.gender === 'Male' ? 'selected' : '' %>>Male</option>
              <option value="Female" <%= family.spouse.gender === 'Female' ? 'selected' : '' %>>Female</option>
              <option value="Other" <%= family.spouse.gender === 'Other' ? 'selected' : '' %>>Other</option>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label">Mobile</label>
            <input class="form-control mobile-field" name="spouse_mobile" maxlength="10" value="<%= family.spouse.mobile %>">
          </div>
          <div class="col-md-3">
            <label class="form-label">Occupation</label>
            <input class="form-control" name="spouse_occupation" value="<%= family.spouse.occupation %>">
          </div>
          <div class="col-md-12">
            <label class="form-label">Image</label>
            <div class="d-flex align-items-center gap-2">
              <img src="<%= family.spouse.image ? '/uploads/' + family.spouse.image : 'https://via.placeholder.com/88?text=Spouse' %>" class="preview" id="spousePreview">
              <input type="file" class="d-none photo-input" id="spouse_image_input" accept="image/*" name="spouse_image" data-preview-id="spousePreview" onchange="previewImage(this, 'spousePreview')">
              <button type="button" class="btn btn-outline-secondary choose-photo-btn" data-input-id="spouse_image_input">Upload Photo</button>
            </div>
          </div>
        </div>
      </div>

      <div class="card p-3 mb-3">
        <h5 class="section-title">ADDRESS</h5>
        <div class="row g-3">
          <div class="col-md-2">
            <label class="form-label">Door No</label>
            <input class="form-control" name="door_no" value="<%= family.self.door_no %>">
          </div>
          <div class="col-md-4">
            <label class="form-label">Street</label>
            <input class="form-control" name="street" value="<%= family.self.street %>">
          </div>
          <div class="col-md-2">
            <label class="form-label">State</label>
            <select class="form-select" name="state" id="stateSelect">
              <option value="">Select State</option>
              <% states.forEach(state => { %>
                <option value="<%= state %>" <%= family.self.state === state ? 'selected' : '' %>>
                  <%= state %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">District</label>
            <select class="form-select" name="district" id="districtSelect">
              <option value="">Select District</option>
              <% if (family.self.state) { %>
                <!-- Districts will be populated by JavaScript -->
              <% } %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label">Pincode</label>
            <input class="form-control" name="pincode" value="<%= family.self.pincode %>">
          </div>
        </div>
      </div>

      <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="section-title mb-0">CHILDREN</h5>
          <button type="button" class="btn btn-sm btn-primary" id="addChildBtn"><i class="fas fa-plus"></i> Add Child</button>
        </div>
        <div id="childrenContainer"></div>
      </div>

      <div class="card p-3 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="section-title mb-0">SIBLINGS</h5>
          <button type="button" class="btn btn-sm btn-primary" id="addSiblingBtn"><i class="fas fa-plus"></i> Add Sibling</button>
        </div>
        <div id="siblingsContainer"></div>
      </div>

      <div class="d-flex gap-2 mb-4">
        <button class="btn btn-primary" type="submit">Update Family</button>
        <a href="/admin/dashboard" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>

  <div class="modal fade" id="photoOptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Select Photo Option</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body d-flex gap-2 justify-content-center">
          <button type="button" class="btn btn-primary" id="browseBtn">Browse</button>
          <button type="button" class="btn btn-secondary" id="cameraBtn">Take Photo</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Family data store -->
  <div id="familyDataStore" style="display:none;" 
       data-children='<%= JSON.stringify(family.children || []) %>'
       data-siblings='<%= JSON.stringify(family.siblings || []) %>'></div>

  <script>
    // Parse family data from HTML attributes
    const dataStore = document.getElementById('familyDataStore');
    const childrenData = JSON.parse(dataStore.dataset.children);
    const siblingsData = JSON.parse(dataStore.dataset.siblings);
    let currentPhotoInputId = null;

    const photoOptionModalElement = document.getElementById("photoOptionModal");
    const photoOptionModal = new bootstrap.Modal(photoOptionModalElement);

    function previewImage(input, previewId) {
      const file = input.files && input.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById(previewId).src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function childTemplate(index, child) {
      const gender = child && child.gender ? child.gender : "";
      const image = child && child.image ? "/uploads/" + child.image : "https://via.placeholder.com/88?text=Child";
      return `
      <div class="dynamic-item" data-type="child">
        <input type="hidden" name="children[${index}][id]" value="${child && child.id ? child.id : ""}">
        
        <div class="dynamic-item-header">
          <h6 class="dynamic-item-title"><i class="fas fa-child"></i> Child <span class="dynamic-child-number">${index + 1}</span></h6>
          <button type="button" class="btn btn-sm dynamic-item-remove-btn" data-remove="child"><i class="fas fa-trash-alt"></i> Remove</button>
        </div>

        <div class="dynamic-item-fields">
          <div class="dynamic-item-field">
            <label class="form-label">Name</label>
            <input class="form-control" name="children[${index}][name]" value="${child && child.name ? child.name : ""}" placeholder="Full name">
          </div>
          <div class="dynamic-item-field">
            <label class="form-label">Gender</label>
            <select class="form-select" name="children[${index}][gender]">
              <option value="">Select</option>
              <option value="Male" ${gender === "Male" ? "selected" : ""}>Male</option>
              <option value="Female" ${gender === "Female" ? "selected" : ""}>Female</option>
              <option value="Other" ${gender === "Other" ? "selected" : ""}>Other</option>
            </select>
          </div>
          <div class="dynamic-item-field">
            <label class="form-label">Date of Birth</label>
            <input type="date" class="form-control" name="children[${index}][dob]" value="${child && child.dob ? child.dob : ""}">
          </div>
        </div>

        <div style="display: flex; gap: 2rem; align-items: flex-start;">
          <div class="dynamic-item-image-block">
            <img id="childPreview_${index}" src="${image}" class="dynamic-item-preview" alt="Child Photo">
            <div class="dynamic-item-actions">
              <input type="file" class="d-none photo-input" id="child_image_${index}" accept="image/*" name="children[${index}][image]" data-preview-id="childPreview_${index}" onchange="previewImage(this, 'childPreview_${index}')">
              <button type="button" class="btn btn-outline-secondary choose-photo-btn" data-input-id="child_image_${index}"><i class="fas fa-camera"></i> Upload</button>
            </div>
          </div>
        </div>
      </div>`;
    }

    function siblingTemplate(index, sibling) {
      const gender = sibling && sibling.gender ? sibling.gender : "";
      const relation = sibling && sibling.relation ? sibling.relation.toLowerCase() : "brother";
      const image = sibling && sibling.image ? "/uploads/" + sibling.image : "https://via.placeholder.com/88?text=Sibling";
      return `
      <div class="dynamic-item" data-type="sibling">
        <input type="hidden" name="siblings[${index}][id]" value="${sibling && sibling.id ? sibling.id : ""}">
        
        <div class="dynamic-item-header">
          <h6 class="dynamic-item-title"><i class="fas fa-person-half-dress"></i> Sibling <span class="dynamic-sibling-number">${index + 1}</span></h6>
          <button type="button" class="btn btn-sm dynamic-item-remove-btn" data-remove="sibling"><i class="fas fa-trash-alt"></i> Remove</button>
        </div>

        <div class="dynamic-item-fields">
          <div class="dynamic-item-field">
            <label class="form-label">Name</label>
            <input class="form-control" name="siblings[${index}][name]" value="${sibling && sibling.name ? sibling.name : ""}" placeholder="Full name">
          </div>
          <div class="dynamic-item-field">
            <label class="form-label">Gender</label>
            <select class="form-select" name="siblings[${index}][gender]">
              <option value="">Select</option>
              <option value="Male" ${gender === "Male" ? "selected" : ""}>Male</option>
              <option value="Female" ${gender === "Female" ? "selected" : ""}>Female</option>
              <option value="Other" ${gender === "Other" ? "selected" : ""}>Other</option>
            </select>
          </div>
          <div class="dynamic-item-field">
            <label class="form-label">Relation</label>
            <select class="form-select" name="siblings[${index}][relation]">
              <option value="brother" ${relation === "brother" ? "selected" : ""}>Brother</option>
              <option value="sister" ${relation === "sister" ? "selected" : ""}>Sister</option>
            </select>
          </div>
        </div>

        <div style="display: flex; gap: 2rem; align-items: flex-start;">
          <div class="dynamic-item-image-block">
            <img id="siblingPreview_${index}" src="${image}" class="dynamic-item-preview" alt="Sibling Photo">
            <div class="dynamic-item-actions">
              <input type="file" class="d-none photo-input" id="sibling_image_${index}" accept="image/*" name="siblings[${index}][image]" data-preview-id="siblingPreview_${index}" onchange="previewImage(this, 'siblingPreview_${index}')">
              <button type="button" class="btn btn-outline-secondary choose-photo-btn" data-input-id="sibling_image_${index}"><i class="fas fa-camera"></i> Upload</button>
            </div>
          </div>
        </div>
      </div>`;
    }

    function renderInitialCollections() {
      const childContainer = document.getElementById("childrenContainer");
      const siblingContainer = document.getElementById("siblingsContainer");

      if (childrenData.length === 0) {
        childContainer.innerHTML = childTemplate(0, {});
        childIndex = 1;
      } else {
        childrenData.forEach((child, index) => {
          childContainer.insertAdjacentHTML("beforeend", childTemplate(index, child));
        });
      }

      if (siblingsData.length === 0) {
        siblingContainer.innerHTML = siblingTemplate(0, {});
        siblingIndex = 1;
      } else {
        siblingsData.forEach((sibling, index) => {
          siblingContainer.insertAdjacentHTML("beforeend", siblingTemplate(index, sibling));
        });
      }
    }

    function validateMobileFields(event) {
      const invalid = Array.from(document.querySelectorAll(".mobile-field"))
        .filter(field => field.value && !/^\d{10}$/.test(field.value.trim()));

      if (invalid.length > 0) {
        event.preventDefault();
        alert("Mobile number must be exactly 10 digits");
        invalid[0].focus();
      }
    }

    function setInputFile(inputElement, file) {
      if (!inputElement || !file) {
        return;
      }

      const transfer = new DataTransfer();
      transfer.items.add(file);
      inputElement.files = transfer.files;

      const previewId = inputElement.dataset.previewId;
      if (previewId) {
        previewImage(inputElement, previewId);
      }
    }

    function capturePhoto(inputId) {
      const inputElement = document.getElementById(inputId);
      if (!inputElement) {
        return;
      }

      navigator.mediaDevices.getUserMedia({ video: true })
        .then((stream) => {
          const overlay = document.createElement("div");
          overlay.style.cssText = "position:fixed;inset:0;background:rgba(0,0,0,0.75);display:flex;align-items:center;justify-content:center;z-index:2000;";

          const panel = document.createElement("div");
          panel.style.cssText = "background:#fff;padding:12px;border-radius:10px;max-width:92vw;";

          const video = document.createElement("video");
          video.autoplay = true;
          video.playsInline = true;
          video.srcObject = stream;
          video.style.cssText = "max-width:80vw;max-height:60vh;border-radius:8px;display:block;";

          const controls = document.createElement("div");
          controls.style.cssText = "display:flex;gap:8px;justify-content:flex-end;margin-top:10px;";

          const captureBtn = document.createElement("button");
          captureBtn.type = "button";
          captureBtn.className = "btn btn-primary btn-sm";
          captureBtn.textContent = "Capture";

          const cancelBtn = document.createElement("button");
          cancelBtn.type = "button";
          cancelBtn.className = "btn btn-outline-secondary btn-sm";
          cancelBtn.textContent = "Cancel";

          const cleanUp = () => {
            stream.getTracks().forEach(track => track.stop());
            overlay.remove();
          };

          cancelBtn.onclick = cleanUp;

          captureBtn.onclick = () => {
            const canvas = document.createElement("canvas");
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const ctx = canvas.getContext("2d");
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            canvas.toBlob((blob) => {
              if (!blob) {
                cleanUp();
                return;
              }

              const photoFile = new File([blob], `capture_${Date.now()}.jpg`, { type: "image/jpeg" });
              setInputFile(inputElement, photoFile);
              cleanUp();
            }, "image/jpeg", 0.92);
          };

          controls.appendChild(cancelBtn);
          controls.appendChild(captureBtn);
          panel.appendChild(video);
          panel.appendChild(controls);
          overlay.appendChild(panel);
          document.body.appendChild(overlay);
        })
        .catch(() => {
          alert("Camera is not available on this device/browser");
        });
    }

    document.getElementById("addChildBtn").addEventListener("click", function() {
      const childContainer = document.getElementById("childrenContainer");
      // Get current count of children to use as index
      const currentChildCount = childContainer.querySelectorAll('.dynamic-item').length;
      childContainer.insertAdjacentHTML("beforeend", childTemplate(currentChildCount, {}));
    });

    document.getElementById("addSiblingBtn").addEventListener("click", function() {
      const siblingContainer = document.getElementById("siblingsContainer");
      // Get current count of siblings to use as index
      const currentSiblingCount = siblingContainer.querySelectorAll('.dynamic-item').length;
      siblingContainer.insertAdjacentHTML("beforeend", siblingTemplate(currentSiblingCount, {}));
    });

    document.addEventListener("click", function(event) {
      // Photo button click
      if (event.target.classList.contains("choose-photo-btn") || event.target.closest(".choose-photo-btn")) {
        const btn = event.target.closest(".choose-photo-btn");
        currentPhotoInputId = btn.dataset.inputId;
        photoOptionModal.show();
        return;
      }

      // Remove button click
      if (event.target.closest(".dynamic-item-remove-btn")) {
        event.target.closest(".dynamic-item").remove();
        // Re-index children and siblings
        updateDynamicNumbering();
      }
    });

    function updateDynamicNumbering() {
      // Re-index children
      document.querySelectorAll('#childrenContainer .dynamic-child-number').forEach((el, index) => {
        el.textContent = index + 1;
      });

      // Re-index siblings
      document.querySelectorAll('#siblingsContainer .dynamic-sibling-number').forEach((el, index) => {
        el.textContent = index + 1;
      });
    }

    document.getElementById("browseBtn").addEventListener("click", function() {
      if (!currentPhotoInputId) {
        return;
      }
      photoOptionModal.hide();
      const inputElement = document.getElementById(currentPhotoInputId);
      if (inputElement) {
        inputElement.click();
      }
    });

    document.getElementById("cameraBtn").addEventListener("click", function() {
      if (!currentPhotoInputId) {
        return;
      }
      photoOptionModal.hide();
      capturePhoto(currentPhotoInputId);
    });

    document.getElementById("adminEditForm").addEventListener("submit", validateMobileFields);

    // Initialize State/District Cascading Dropdowns
    const stateDistrictMap = <%- JSON.stringify(stateDistrictMap || {}) %>;
    const currentState = '<%= family.self.state %>';
    const currentDistrict = '<%= family.self.district %>';

    function populateDistrictDropdown(stateName) {
      const districtSelect = document.getElementById('districtSelect');
      districtSelect.innerHTML = '<option value="">Select District</option>';

      if (stateName && stateDistrictMap[stateName]) {
        stateDistrictMap[stateName].forEach(district => {
          const option = document.createElement('option');
          option.value = district;
          option.textContent = district;
          if (district === currentDistrict) {
            option.selected = true;
          }
          districtSelect.appendChild(option);
        });
      }
    }

    // Handle state change event
    document.getElementById('stateSelect').addEventListener('change', function() {
      populateDistrictDropdown(this.value);
    });

    // Initialize district dropdown on page load with current state
    if (currentState) {
      populateDistrictDropdown(currentState);
    }

    renderInitialCollections();
  </script>
</body>
</html>