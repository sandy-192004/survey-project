<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Family View</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <style>
    body {
      margin: 0;
      background: #f5f7fb;
      color: #1f2937;
    }

    .page-header {
      background: linear-gradient(135deg, #374151, #111827);
      color: #fff;
      padding: 1.5rem 1rem;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    }

    .page-title {
      font-size: 1.75rem;
      font-weight: 700;
      margin: 0;
    }

    .section-title {
      margin: 1.5rem 0 0.75rem;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.06em;
      color: #374151;
      text-transform: uppercase;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .id-card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
      padding: 0.9rem;
      display: flex;
      gap: 0.85rem;
      box-shadow: 0 8px 20px rgba(17, 24, 39, 0.08);
      min-height: 170px;
    }

    .id-photo {
      width: 120px;
      height: 150px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid #d1d5db;
      background: #f3f4f6;
      flex-shrink: 0;
    }

    .id-details {
      min-width: 0;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .id-name {
      font-size: 1.1rem;
      font-weight: 700;
      line-height: 1.2;
      margin: 0;
    }

    .id-item {
      font-size: 0.92rem;
      color: #374151;
      line-height: 1.35;
    }

    .id-label {
      font-weight: 700;
      margin-right: 0.25rem;
      color: #111827;
    }

    .id-address {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .empty-note {
      background: #fff;
      border: 1px dashed #cbd5e1;
      border-radius: 10px;
      padding: 1rem;
      color: #6b7280;
      font-size: 0.95rem;
    }

    @media (max-width: 768px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }

      .id-card {
        min-height: auto;
      }
    }
  </style>
</head>
<body>
  <div class="page-header text-center">
    <h1 class="page-title">Family Details</h1>
  </div>

  <div class="container py-4">
    <% 
      const groupedFamily = family || { father: null, mother: null, self: null, spouse: null, siblings: [], children: [] };
      function buildAddress(person) {
        if (!person) return "-";
        return [person.door_no, person.street, person.district, person.state, person.pincode].filter(Boolean).join(", ") || "-";
      }
      function imagePath(person) {
        if (!person || !person.image) return null;
        const rawPath = String(person.image).replace(/^\/+/, "");
        if (rawPath.startsWith("uploads/")) return `/${rawPath}`;
        return `/uploads/${rawPath}`;
      }
      function hasData(section) {
        return Array.isArray(section) ? section.length > 0 : !!section;
      }
      function formatDob(value) {
        if (!value) return "-";
        try {
          return new Date(value).toISOString().split("T")[0];
        } catch (e) {
          return "-";
        }
      }
    %>

    <% if (!groupedFamily.self && !hasData(groupedFamily.siblings) && !hasData(groupedFamily.children) && !groupedFamily.father && !groupedFamily.mother && !groupedFamily.spouse) { %>
      <div class="empty-note text-center">No family data found.</div>
    <% } %>

    <h2 class="section-title">Parents</h2>
    <div class="cards-grid">
      <% [groupedFamily.father, groupedFamily.mother].forEach((person) => { %>
        <% if (person) { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || '/images/default-profile.png' %>" alt="<%= person.name || 'Family member' %>" onerror="this.src='/images/default-profile.png'">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || '-' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>

    <h2 class="section-title">Self + Spouse</h2>
    <div class="cards-grid">
      <% [groupedFamily.self, groupedFamily.spouse].forEach((person) => { %>
        <% if (person) { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || '/images/default-profile.png' %>" alt="<%= person.name || 'Family member' %>" onerror="this.src='/images/default-profile.png'">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || '-' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>

    <h2 class="section-title">Siblings</h2>
    <% if (groupedFamily.siblings && groupedFamily.siblings.length > 0) { %>
      <div class="cards-grid">
        <% groupedFamily.siblings.forEach((person) => { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || '/images/default-profile.png' %>" alt="<%= person.name || 'Sibling' %>" onerror="this.src='/images/default-profile.png'">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || 'Sibling' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-note">No siblings found.</div>
    <% } %>

    <h2 class="section-title">Children</h2>
    <% if (groupedFamily.children && groupedFamily.children.length > 0) { %>
      <div class="cards-grid">
        <% groupedFamily.children.forEach((person) => { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || '/images/default-profile.png' %>" alt="<%= person.name || 'Child' %>" onerror="this.src='/images/default-profile.png'">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || 'Child' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-note">No children found.</div>
    <% } %>

    <div class="text-center mt-4">
      <a href="/admin/dashboard" class="btn btn-dark px-4">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
