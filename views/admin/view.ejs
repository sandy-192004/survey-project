<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Family View</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  <style>
    body {
      margin: 0;
      background: linear-gradient(135deg, #f4e8d8 0%, #e8dcc8 100%);
      color: #592d0f;
      font-family: 'Segoe UI', Tahoma, Geneva, sans-serif;
    }

    .page-header {
      background: linear-gradient(135deg, #704214, #592d0f);
      color: #fff;
      padding: 2.5rem 1.5rem;
      box-shadow: 0 12px 32px rgba(89, 45, 15, 0.25);
      border-bottom: 4px solid #d2b48c;
    }

    .page-title {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 0;
      letter-spacing: 0.5px;
    }

    .section-title {
      margin: 2rem 0 1.2rem;
      font-weight: 800;
      font-size: 1.4rem;
      letter-spacing: 0.1em;
      color: #592d0f;
      text-transform: uppercase;
      background: linear-gradient(90deg, #704214, #8b6f47);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      border-bottom: 3px solid #d2b48c;
      padding-bottom: 0.8rem;
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .id-card {
      background: linear-gradient(135deg, #ffffff, #faf6f1);
      border: 2px solid #d2b48c;
      border-left: 6px solid #704214;
      border-radius: 16px;
      padding: 1.2rem;
      display: flex;
      gap: 1.2rem;
      box-shadow: 0 10px 28px rgba(112, 66, 20, 0.15);
      min-height: 180px;
      transition: all 0.3s ease;
    }

    .id-card:hover {
      box-shadow: 0 14px 40px rgba(89, 45, 15, 0.2);
      transform: translateY(-4px);
      border-color: #704214;
    }

    .id-photo {
      width: 140px;
      height: 160px;
      object-fit: cover;
      border-radius: 12px;
      border: 4px solid #d2b48c;
      background: linear-gradient(135deg, #faf6f1, #f4e8d8);
      flex-shrink: 0;
      box-shadow: 0 6px 16px rgba(112, 66, 20, 0.15);
    }

    .id-details {
      min-width: 0;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .id-name {
      font-size: 1.3rem;
      font-weight: 800;
      line-height: 1.2;
      margin: 0;
      color: #592d0f;
    }

    .id-item {
      font-size: 1.05rem;
      color: #704214;
      line-height: 1.5;
      font-weight: 600;
    }

    .id-label {
      font-weight: 800;
      margin-right: 0.35rem;
      color: #592d0f;
      text-transform: uppercase;
      letter-spacing: 0.2px;
    }

    .id-address {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .empty-note {
      background: linear-gradient(135deg, #ffffff, #faf6f1);
      border: 2px dashed #d2b48c;
      border-radius: 14px;
      padding: 2rem;
      color: #8b6f47;
      font-size: 1.1rem;
      font-weight: 600;
      text-align: center;
      box-shadow: 0 4px 12px rgba(112, 66, 20, 0.08);
    }

    .container {
      max-width: 1100px;
    }

    @media (max-width: 768px) {
      .cards-grid {
        grid-template-columns: 1fr;
      }

      .id-card {
        min-height: auto;
        flex-direction: column;
        align-items: center;
      }

      .id-photo {
        width: 120px;
        height: 140px;
      }

      .page-title {
        font-size: 2rem;
      }

      .section-title {
        font-size: 1.2rem;
      }

      .id-item {
        font-size: 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="page-header text-center">
    <h1 class="page-title">👨‍👩‍👧‍👦 Family Details</h1>
    <p style="font-size: 1.15rem; color: rgba(255,255,255,0.9); margin: 0.5rem 0 0 0; font-weight: 600; letter-spacing: 0.3px;">Complete Family Information Record</p>
  </div>

  <div class="container py-4">
    <% 
      const groupedFamily = family || { father: null, mother: null, self: null, spouse: null, siblings: [], children: [] };
      function buildAddress(person) {
        if (!person) return "-";
        return [person.door_no, person.street, person.district, person.state, person.pincode].filter(Boolean).join(", ") || "-";
      }
      function imagePath(person) {
        if (!person || !person.image) return null;
        const rawPath = String(person.image).replace(/^\/+/, "");
        if (rawPath.startsWith("uploads/")) return `/${rawPath}`;
        return `/uploads/${rawPath}`;
      }
      function hasData(section) {
        return Array.isArray(section) ? section.length > 0 : !!section;
      }
      function formatDob(value) {
        if (!value) return "-";
        try {
          return new Date(value).toISOString().split("T")[0];
        } catch (e) {
          return "-";
        }
      }
    %>

    <% if (!groupedFamily.self && !hasData(groupedFamily.siblings) && !hasData(groupedFamily.children) && !groupedFamily.father && !groupedFamily.mother && !groupedFamily.spouse) { %>
      <div class="empty-note text-center">No family data found.</div>
    <% } %>

    <h2 class="section-title">Parents</h2>
    <div class="cards-grid">
      <% [groupedFamily.father, groupedFamily.mother].forEach((person) => { %>
        <% if (person) { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || 'https://via.placeholder.com/100?text=No+Photo' %>" alt="<%= person.name || 'Family member' %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100?text=No+Photo';">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || '-' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>

    <h2 class="section-title">Self + Spouse</h2>
    <div class="cards-grid">
      <% [groupedFamily.self, groupedFamily.spouse].forEach((person) => { %>
        <% if (person) { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || 'https://via.placeholder.com/100?text=No+Photo' %>" alt="<%= person.name || 'Family member' %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100?text=No+Photo';">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || '-' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>

    <h2 class="section-title">Siblings</h2>
    <% if (groupedFamily.siblings && groupedFamily.siblings.length > 0) { %>
      <div class="cards-grid">
        <% groupedFamily.siblings.forEach((person) => { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || 'https://via.placeholder.com/100?text=No+Photo' %>" alt="<%= person.name || 'Sibling' %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100?text=No+Photo';">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || 'Sibling' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-note">No siblings found.</div>
    <% } %>

    <h2 class="section-title">Children</h2>
    <% if (groupedFamily.children && groupedFamily.children.length > 0) { %>
      <div class="cards-grid">
        <% groupedFamily.children.forEach((person) => { %>
          <div class="id-card">
            <% const img = imagePath(person); %>
            <img class="id-photo" src="<%= img || 'https://via.placeholder.com/100?text=No+Photo' %>" alt="<%= person.name || 'Child' %>" onerror="this.onerror=null;this.src='https://via.placeholder.com/100?text=No+Photo';">
            <div class="id-details">
              <h3 class="id-name"><%= person.name || '-' %></h3>
              <div class="id-item"><span class="id-label">Relationship:</span><%= person.relationship || 'Child' %></div>
              <div class="id-item"><span class="id-label">Gender:</span><%= person.gender || '-' %></div>
              <div class="id-item"><span class="id-label">DOB:</span><%= formatDob(person.dob) %></div>
              <div class="id-item"><span class="id-label">Mobile:</span><%= person.mobile || '-' %></div>
              <div class="id-item"><span class="id-label">Occupation:</span><%= person.occupation || '-' %></div>
              <div class="id-item id-address"><span class="id-label">Address:</span><%= buildAddress(person) %></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-note">No children found.</div>
    <% } %>

    <div class="text-center mt-4">
      <a href="/admin/dashboard" class="btn btn-lg" style="background: linear-gradient(135deg, #704214, #592d0f); color: white; border: none; font-weight: 700; font-size: 1.1rem; box-shadow: 0 6px 16px rgba(112, 66, 20, 0.3);">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
      </a>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>