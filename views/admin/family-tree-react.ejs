<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: "Plus Jakarta Sans", sans-serif;
      background: radial-gradient(circle at 20% 0%, #f8f1e7 0%, #f5eee3 35%, #ece7df 100%);
      min-height: 100vh;
    }
    .title-font {
      font-family: "Playfair Display", serif;
    }
  </style>
</head>
<body>
  <div class="max-w-7xl mx-auto px-4 py-8 md:py-12">
    <div class="text-center mb-6 md:mb-8">
      <h1 class="title-font text-3xl md:text-5xl font-bold text-amber-900 tracking-wide">Our Family Tree</h1>
      <p class="mt-3 text-sm md:text-base text-stone-600">Dynamic genealogy view with multi-generation navigation</p>
    </div>

    <div class="flex justify-between items-center mb-5">
      <a href="/admin/dashboard" class="inline-flex items-center gap-2 rounded-lg border border-amber-800/40 bg-white/70 px-4 py-2 text-amber-900 hover:bg-amber-50 transition-colors">
        <span>Back to Dashboard</span>
      </a>
      <span class="rounded-full bg-amber-100 px-4 py-2 text-xs md:text-sm text-amber-900 border border-amber-200">
        User ID: <%= userId %>
      </span>
    </div>

    <div id="family-tree-root" class="rounded-2xl border border-amber-900/15 bg-white/50 shadow-lg backdrop-blur-sm min-h-[70vh] overflow-hidden"></div>
  </div>

  <script>
    window.__FAMILY_TREE_BOOTSTRAP__ = {
      userId: <%= userId %>,
      rootPersonId: <%= rootPersonId %>
    };
  </script>
  <script type="module" src="/js/family-tree/main.js"></script>
</body>
</html>
